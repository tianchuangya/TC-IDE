# The extension ships two bundles and the files the manifest names. Everything
# else - sources, the individual compiled modules, the harness, its screenshots
# - is development material and would only make the download bigger.
src/**
scripts/**
fixtures/**
node_modules/**
**/*.map
tsconfig.json
esbuild.mjs
.eslintrc.json
.gitignore
dist/modules/**
dist/harness/**
media/harness.js
harness-shots/**
tc-ide-companion.vsix
