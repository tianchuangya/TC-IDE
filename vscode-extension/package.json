{
  "name": "tc-ide-companion",
  "displayName": "TC-IDE Companion",
  "description": "TC-IDE 的语义关系图、项目文档与构建可视化，作为 VS Code 扩展。",
  "version": "0.1.0",
  "publisher": "tianchuangya",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "semantic graph",
    "call hierarchy",
    "tc-ide"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:tcIde.openGraph",
    "onCommand:tcIde.refreshGraph",
    "onCommand:tcIde.build",
    "onCommand:tcIde.run",
    "onCommand:tcIde.package",
    "onCommand:tcIde.openDynamicEditor",
    "onCustomEditor:tcIde.dynamicEditor",
    "onView:tcIde.graphView"
  ],
  "contributes": {
    "configuration": {
      "title": "TC-IDE Companion",
      "properties": {
        "tcIde.graph.defaultRelation": {
          "type": "string",
          "enum": [
            "follow",
            "callers",
            "callees"
          ],
          "default": "follow",
          "enumDescriptions": [
            "跟随当前符号",
            "只看调用者",
            "只看被调用"
          ],
          "description": "关系图默认显示的关系方向。"
        },
        "tcIde.graph.defaultScope": {
          "type": "string",
          "enum": [
            "auto",
            "project",
            "folder",
            "file",
            "symbol"
          ],
          "default": "auto",
          "enumDescriptions": [
            "依次优先：悬停符号 → 光标符号 → 当前文件",
            "整个项目",
            "当前文件夹",
            "当前文件",
            "当前符号"
          ],
          "description": "关系图默认范围。"
        },
        "tcIde.graph.maxNodes": {
          "type": "number",
          "default": 240,
          "minimum": 20,
          "maximum": 2000,
          "description": "关系图节点上限；超过后聚类。默认与原生共享核心一致。"
        },
        "tcIde.graph.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/target/**",
            "**/.git/**"
          ],
          "description": "索引时排除的路径；与 files.exclude、search.exclude、.gitignore 合并。"
        },
        "tcIde.graph.followDelayMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 3000,
          "description": "鼠标离开编辑器后，回退到光标焦点前的延迟。"
        },
        "tcIde.graph.hoverRevertMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 3000,
          "description": "悬停符号失效后多久回退到光标焦点。"
        },
        "tcIde.editor.decorations": {
          "type": "boolean",
          "default": true,
          "description": "在编辑器中显示当前符号与关系标识。"
        },
        "tcIde.editor.maxDecorations": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 50,
          "description": "同时高亮的关系数量上限；超出后只在关系图显示。"
        },
        "tcIde.editor.typingEffect": {
          "type": "string",
          "enum": ["none", "glow", "pulse"],
          "default": "pulse",
          "description": "输入或删除时的微动效；不会替换 VS Code 原生文字渲染。"
        },
        "tcIde.editor.nativeSmoothCaret": {
          "type": "boolean",
          "default": true,
          "description": "使用 VS Code 官方平滑光标动画。"
        },
        "tcIde.dynamicEditor.mouseTrail": {
          "type": "boolean",
          "default": true,
          "description": "TC 动态编辑器内显示低开销的鼠标余晖。"
        },
        "tcIde.dynamicEditor.lineTransition": {
          "type": "boolean",
          "default": true,
          "description": "TC 动态编辑器按回车时显示行切换波纹。"
        },
        "tcIde.editor.commentBubbles": {
          "type": "boolean",
          "default": true,
          "description": "在识别到的代码注释末尾显示可读的注释气泡。"
        },
        "tcIde.editor.commentBubbleStyle": {
          "type": "string",
          "enum": ["soft", "outline", "minimal"],
          "default": "soft",
          "description": "注释气泡样式。"
        },
        "tcIde.appearance.backgroundImage": {
          "type": "string",
          "default": "",
          "description": "TC-IDE 插件页面背景图片的本地绝对路径。"
        },
        "tcIde.appearance.backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.12,
          "description": "TC-IDE 插件页面背景图不透明度。"
        },
        "tcIde.package.animate": {
          "type": "boolean",
          "default": true,
          "description": "构建时显示黑洞/白洞动画；关闭后只显示状态。"
        },
        "tcIde.reducedMotion": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "enumDescriptions": [
            "跟随系统与 VS Code 设置",
            "始终使用减少动效",
            "始终使用完整动效"
          ],
          "description": "是否减少动画。"
        }
      }
    },
    "commands": [
      {
        "command": "tcIde.openGraph",
        "title": "打开语义关系图",
        "category": "TC-IDE",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tcIde.refreshGraph",
        "title": "刷新关系图",
        "category": "TC-IDE",
        "icon": "$(refresh)"
      },
      {
        "command": "tcIde.focusScope",
        "title": "切换关系范围",
        "category": "TC-IDE",
        "icon": "$(list-selection)"
      },
      {
        "command": "tcIde.toggleRelation",
        "title": "切换关系方向",
        "category": "TC-IDE",
        "icon": "$(arrow-both)"
      },
      {
        "command": "tcIde.createProjectDocument",
        "title": "创建 .tcIDE 项目文档",
        "category": "TC-IDE",
        "icon": "$(new-file)"
      },
      {
        "command": "tcIde.openSettings",
        "title": "打开 TC-IDE 设置",
        "category": "TC-IDE",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tcIde.openDynamicEditor",
        "title": "用 TC 动态编辑器打开当前文件",
        "category": "TC-IDE",
        "icon": "$(symbol-key)"
      },
      {
        "command": "tcIde.build",
        "title": "编译项目",
        "category": "TC-IDE",
        "icon": "$(tools)"
      },
      {
        "command": "tcIde.run",
        "title": "运行项目",
        "category": "TC-IDE",
        "icon": "$(play)"
      },
      {
        "command": "tcIde.package",
        "title": "打包项目",
        "category": "TC-IDE",
        "icon": "$(package)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tcIde",
          "title": "TC-IDE",
          "icon": "media/icons/tc-ide.svg"
        }
      ]
    },
    "views": {
      "tcIde": [
        {
          "type": "webview",
          "id": "tcIde.graphView",
          "name": "调用层级",
          "icon": "media/icons/tc-ide.svg",
          "contextualTitle": "TC-IDE 调用层级"
        },
        {
          "type": "webview",
          "id": "tcIde.settingsView",
          "name": "外观与动效",
          "icon": "media/icons/tc-ide.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tcIde.graphView",
        "contents": "打开一个项目后显示语义关系。\n[刷新关系图](command:tcIde.refreshGraph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tcIde.refreshGraph",
          "when": "view == tcIde.graphView",
          "group": "navigation@1"
        },
        {
          "command": "tcIde.focusScope",
          "when": "view == tcIde.graphView",
          "group": "navigation@2"
        },
        {
          "command": "tcIde.openSettings",
          "when": "view == tcIde.graphView",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tcIde.openGraph",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tcIde.build",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tcIde.run",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "tcIde.package",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "themes": [
      {
        "label": "TC-IDE Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/tc-ide-dark-color-theme.json"
      },
      {
        "label": "TC-IDE Light",
        "uiTheme": "vs",
        "path": "./themes/tc-ide-light-color-theme.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "tcIde.dynamicEditor",
        "displayName": "TC 动态编辑器",
        "selector": [
          { "filenamePattern": "*.c" }, { "filenamePattern": "*.h" },
          { "filenamePattern": "*.cc" }, { "filenamePattern": "*.cpp" },
          { "filenamePattern": "*.hpp" }, { "filenamePattern": "*.rs" },
          { "filenamePattern": "*.py" }, { "filenamePattern": "*.ts" },
          { "filenamePattern": "*.tsx" }, { "filenamePattern": "*.js" },
          { "filenamePattern": "*.java" }, { "filenamePattern": "*.go" }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs && tsc --outDir dist/modules",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "tsc --outDir dist/modules && node scripts/run-tests.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out tc-ide-companion.vsix",
    "verify:package": "node scripts/verify-package.mjs",
    "harness": "node scripts/capture-harness.mjs",
    "harness:geometry": "node scripts/geometry-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "puppeteer": "^23.0.0",
    "typescript": "^5.3.0"
  }
}
